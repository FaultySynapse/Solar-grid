{
  "category": "ac_unit",
  "specs": {
    "supply_type": {
      "definition": "Electrical input type the unit requires",
      "type": "enum",
      "values": [
        "AC",
        "DC"
      ]
    },
    "supply_voltage": {
      "definition": "Nominal supply voltage(s). A list means multi-voltage capable.",
      "unit": "V",
      "type": "number|list"
    },
    "cooling_btu": {
      "definition": "Rated cooling capacity",
      "unit": "BTU/h",
      "type": "number"
    },
    "running_w": {
      "definition": "Typical power draw while cooling (not nameplate max)",
      "unit": "W",
      "type": "number"
    },
    "running_a": {
      "definition": "Typical current draw while cooling",
      "unit": "A",
      "type": "number"
    },
    "inverter_compressor": {
      "definition": "Variable-speed (soft-start, modulating) compressor",
      "type": "bool"
    },
    "eer": {
      "definition": "Energy Efficiency Ratio (BTU/h per W); higher is better off-grid",
      "type": "number"
    },
    "seer2": {
      "definition": "Seasonal EER (marketing headline; less predictive of off-grid draw than EER)",
      "type": "number"
    },
    "form_factor": {
      "definition": "Physical type",
      "type": "enum",
      "values": [
        "split",
        "split-vehicle",
        "window",
        "self-contained"
      ]
    },
    "diy_install": {
      "definition": "Can be installed without a vacuum pump / EPA cert (pre-charged QuickConnect)",
      "type": "bool"
    },
    "refrigerant": {
      "definition": "Refrigerant type",
      "type": "string"
    },
    "fit": {
      "definition": "Suitability tag for this project",
      "type": "enum",
      "values": [
        "good",
        "tradeoff",
        "avoid"
      ]
    },
    "price_usd": {
      "definition": "Approximate street price (verify)",
      "unit": "USD",
      "type": "number"
    },
    "source": {
      "definition": "Reference URL",
      "type": "string"
    },
    "mass_kg": {
      "definition": "Mass of one unit/block (feeds system_mass_kg)",
      "unit": "kg",
      "type": "number"
    }
  },
  "guidance": [
    "Inverter (variable-speed) compressors soft-start and modulate; strongly preferred over fixed-speed for off-grid.",
    "For an AC (115/230 V) unit, prefer 115 V \u2014 it runs off a common 120 V inverter; 230 V needs a split-phase/230 V inverter for no benefit at this size.",
    "Pick AC units on EER, not SEER2: at desert daytime temps the compressor runs hard, so steady-state EER predicts battery draw better than the seasonal SEER2 headline.",
    "For a tiny shaded tent, a 9k (or 6k) unit is heavily oversized and will idle at minimum modulation (~2-4 kWh over 8 h) unless the tent is leaky.",
    "Split install on fabric is the real friction (indoor head + outdoor condenser + lineset + usually a vacuum pump). MRCOOL DIY avoids the vacuum; a window unit avoids the split but needs a rigid framed port.",
    "12 V DC coolers are cheap but pull 40-80 A (thick short cables) and need a 24->12 V converter on a 24 V bank.",
    "A native 24/48 V DC unit skips the inverter entirely and, on 48 V, cuts wiring current ~4x vs 12 V.",
    "NOT battery-bus units: HotSpot ACDC12C and EG4 hybrid take high-voltage PV-direct (90-380 V) + AC grid; excluded from DC-bus builds.",
    "Confirm the chosen unit's real running watts + duty cycle (clamp meter) \u2014 it drives array size. New stock is R454B/R32; R410A is being phased out."
  ],
